PORT=5000
MONGO_URI=
JWT_SECRET=
GEMINI_API_KEY=
TWELVE_DATA_KEY=
NEWS_API_KEY=
GROQ_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Base URL of the deployed web app, used to build links inside emails
# (e.g. the password reset link). No trailing slash.
APP_BASE_URL=

# Comma-separated list of allowed frontend origins for CORS in production
# e.g. https://your-app.vercel.app
FRONTEND_URL=

# Alerts outside the app (services/notifyDispatcher.js).
# Browser push: optional -- if unset, a VAPID key pair is generated once
# and stored in MongoDB automatically.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=
# Android app push: the Firebase service-account JSON (raw or base64).
# Firebase console -> Project settings -> Service accounts -> Generate key.
FIREBASE_SERVICE_ACCOUNT=
